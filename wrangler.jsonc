{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jacka-cyber-quiz",
  "main": "server/cloudflare/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_DO",
        "class_name": "MatchDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["MatchDO"]
    }
  ]
}
